# ==============================================================================
# Configuraciones y Variables de Entorno (Debian Sway Fluent Purple)
# ==============================================================================

# Agregar binarios locales al PATH
if [ -d "$HOME/.local/bin" ] ; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Variables de entorno para Wayland y Sway
export XDG_CURRENT_DESKTOP="sway:GNOME"
export XDG_SESSION_DESKTOP=sway
export XDG_SESSION_TYPE=wayland

# Entorno para temas Fluent Purple y soporte Qt Dark Mode (Kvantum)
export GTK_THEME="Fluent-purple-Dark"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="gtk3"
export QT_STYLE_OVERRIDE="kvantum"
export QT_PLUGIN_PATH="$HOME/.local/usr/lib/x86_64-linux-gnu/qt6/plugins:$HOME/.local/usr/lib/x86_64-linux-gnu/qt5/plugins:$QT_PLUGIN_PATH"
export LD_LIBRARY_PATH="$HOME/.local/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# Soporte Wayland nativo para aplicaciones Firefox y Electron
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export GDK_BACKEND="wayland,x11,*"
