# Mako Notification Daemon Configuration
# Fluent Purple Minimalist & Modern Style

font=DejaVu Sans 10
background-color=#16121aee
text-color=#ffffff
border-color=#ba68c8
border-size=1
border-radius=8

width=340
height=130
margin=16
padding=14
default-timeout=5000
group-by=summary

icons=1
max-icon-size=40

# Progress bar inside notification
progress-color=over #ba68c8

[urgency=low]
border-color=#3d2a4c
text-color=#b0a8b8
default-timeout=3000

[urgency=high]
border-color=#ba68c8
text-color=#ffffff
default-timeout=0
