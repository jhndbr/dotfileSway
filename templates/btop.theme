# ╔══════════════════════════════════════════════════════════════╗
# ║        Tema Dinámico de Btop para Matugen                    ║
# ║        Sincronizado con Material 3 y Wallpaper               ║
# ╚══════════════════════════════════════════════════════════════╝

# Fondo transparente para heredar el desenfoque / terminal
theme[main_bg]=""

# Texto principal
theme[main_fg]="#{{colors.on_surface.default.hex_stripped}}"

# Título de las cajas
theme[title]="#{{colors.primary.default.hex_stripped}}"

# Resaltado de atajos de teclado
theme[hi_fg]="#{{colors.tertiary.default.hex_stripped}}"

# Fondo del elemento seleccionado
theme[selected_bg]="#{{colors.primary_container.default.hex_stripped}}"

# Texto del elemento seleccionado
theme[selected_fg]="#{{colors.on_primary_container.default.hex_stripped}}"

# Texto inactivo / deshabilitado
theme[inactive_fg]="#{{colors.outline.default.hex_stripped}}"

# Texto superpuesto en gráficos
theme[graph_text]="#{{colors.on_surface_variant.default.hex_stripped}}"

# Fondo de los medidores de porcentaje
theme[meter_bg]="#{{colors.surface_container_highest.default.hex_stripped}}"

# Procesos varios y gráficos secundarios
theme[proc_misc]="#{{colors.secondary.default.hex_stripped}}"

# Bordes de las cajas
theme[cpu_box]="#{{colors.outline.default.hex_stripped}}"
theme[mem_box]="#{{colors.outline.default.hex_stripped}}"
theme[net_box]="#{{colors.outline.default.hex_stripped}}"
theme[proc_box]="#{{colors.outline.default.hex_stripped}}"
theme[div_line]="#{{colors.outline_variant.default.hex_stripped}}"

# Gradiente de Temperatura
theme[temp_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[temp_mid]="#{{colors.primary.default.hex_stripped}}"
theme[temp_end]="#{{colors.error.default.hex_stripped}}"

# Gradiente de CPU
theme[cpu_start]="#{{colors.primary.default.hex_stripped}}"
theme[cpu_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[cpu_end]="#{{colors.error.default.hex_stripped}}"

# Medidor Libre Memoria/Disco
theme[free_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[free_mid]="#{{colors.secondary.default.hex_stripped}}"
theme[free_end]="#{{colors.error.default.hex_stripped}}"

# Medidor Memoria en Caché
theme[cached_start]="#{{colors.secondary.default.hex_stripped}}"
theme[cached_mid]="#{{colors.primary.default.hex_stripped}}"
theme[cached_end]="#{{colors.error.default.hex_stripped}}"

# Medidor Memoria Disponible
theme[available_start]="#{{colors.tertiary.default.hex_stripped}}"
theme[available_mid]="#{{colors.primary.default.hex_stripped}}"
theme[available_end]="#{{colors.error.default.hex_stripped}}"

# Medidor Memoria Usada
theme[used_start]="#{{colors.primary.default.hex_stripped}}"
theme[used_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[used_end]="#{{colors.error.default.hex_stripped}}"

# Gradiente de Descarga de Red
theme[download_start]="#{{colors.primary.default.hex_stripped}}"
theme[download_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[download_end]="#{{colors.secondary.default.hex_stripped}}"

# Gradiente de Subida de Red
theme[upload_start]="#{{colors.secondary.default.hex_stripped}}"
theme[upload_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[upload_end]="#{{colors.error.default.hex_stripped}}"

# Gradiente de Procesos
theme[process_start]="#{{colors.primary.default.hex_stripped}}"
theme[process_mid]="#{{colors.tertiary.default.hex_stripped}}"
theme[process_end]="#{{colors.error.default.hex_stripped}}"
