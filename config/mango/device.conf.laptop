# ╔══════════════════════════════════════════════════════════════╗
# ║        Configuración para Laptop / Notebook (MangoWM)          ║
# ║        Touchpad, Gestos, Brillo, Batería, Tapa                 ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Touchpad habilitado con gestos naturales ────────────────────
disable_trackpad=0
tap_to_click=1
tap_and_drag=1
drag_lock=1
trackpad_natural_scrolling=1
disable_while_typing=1
