{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/cat.txt",
        "color": {
            "1": "#93d786"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰅂 ",
        "color": {
            "keys": "#baccb2",
            "title": "#93d786"
        },
        "constants": [
            "───────────────────────────────────────────"
        ]
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "os",
            "key": "󰣇  OS",
            "format": "{3}",
            "keyColor": "#93d786"
        },
        {
            "type": "command",
            "key": "󰌽  Kernel",
            "keyColor": "#93d786",
            "text": "uname -r | cut -d- -f1 | sed 's/^/Linux /'"
        },
        {
            "type": "packages",
            "key": "󰏖  Paquetes",
            "keyColor": "#93d786"
        },
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "wm",
            "key": "󰨇  Compositor",
            "format": "MangoWM",
            "keyColor": "#baccb2"
        },
        {
            "type": "terminal",
            "key": "󰞷  Terminal",
            "format": "{1}",
            "keyColor": "#baccb2"
        },
        {
            "type": "shell",
            "key": "󰞷  Shell",
            "format": "{1}",
            "keyColor": "#baccb2"
        },
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "cpu",
            "key": "󰻠  CPU",
            "format": "{1}",
            "keyColor": "#a0cfd3"
        },
        {
            "type": "gpu",
            "key": "󰢮  GPU",
            "format": "{2}",
            "keyColor": "#a0cfd3"
        },
        {
            "type": "memory",
            "key": "󰍛  RAM",
            "format": "{1} / {2}",
            "keyColor": "#a0cfd3"
        },
        {
            "type": "custom",
            "format": "{$1}"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
