{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/menu",
        "group/workspaces",
        "custom/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpris",
        "group/weather",
        "tray",
        "group/quicksettings",
        "group/controls",
        "group/hardware",
        "custom/power"
    ],

    /* ── Menú de Inicio Minimalista ──────────────────────────────── */
    "custom/menu": {
        "format": "󰣇",
        "tooltip-format": "Lanzador de Aplicaciones (Click Izq: Wofi | Click Der: Menú CLI)",
        "on-click": "wofi --show drun",
        "on-click-right": "~/.local/bin/cli-apps-menu.sh",
        "tooltip": true
    },

    /* ── Espacios de Trabajo con Iconos de Aplicaciones (MangoWM) ── */
    "group/workspaces": {
        "orientation": "horizontal",
        "modules": [
            "custom/ws1",
            "custom/ws2",
            "custom/ws3",
            "custom/ws4",
            "custom/ws5",
            "custom/ws6",
            "custom/ws7",
            "custom/ws8",
            "custom/ws9"
        ]
    },

    "custom/ws1": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 1",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,1; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws2": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 2",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,2; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws3": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 3",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,3; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws4": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 4",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,4; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws5": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 5",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,5; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws6": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 6",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,6; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws7": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 7",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,7; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws8": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 8",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,8; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },
    "custom/ws9": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py 9",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "on-click": "mmsg dispatch view,9; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-up": "mmsg dispatch viewtoleft; ~/.local/bin/waybar-mango-workspaces.py update",
        "on-scroll-down": "mmsg dispatch viewtoright; ~/.local/bin/waybar-mango-workspaces.py update",
        "tooltip": true
    },

    /* ── Título de la Ventana Activa ─────────────────────────────── */
    "custom/window": {
        "exec": "~/.local/bin/waybar-mango-workspaces.py window",
        "return-type": "json",
        "signal": 1,
        "interval": "once",
        "max-length": 45,
        "tooltip": true
    },

    /* ── Clima Drawer en el Centro (Muestra Temperatura en Hover) ── */
    "group/weather": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/weather-icon",
            "custom/weather-text"
        ]
    },

    "custom/weather-icon": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-weather.sh icon",
        "interval": 300,
        "tooltip": true,
        "on-click": "xdg-open 'https://wttr.in' 2>/dev/null || true"
    },

    "custom/weather-text": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-weather.sh text",
        "interval": 300,
        "tooltip": true,
        "on-click": "xdg-open 'https://wttr.in' 2>/dev/null || true"
    },

    /* ── Reloj y Fecha (Centro) ──────────────────────────────────── */
    "clock": {
        "format": "{:%a %d %b · %H:%M}",
        "format-alt": "{:%A %d de %B, %Y  ·  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "locale": "es_AR.UTF-8",
        "interval": 1
    },

    /* ── Reproductor Multimedia Nativo (MPRIS — DBus Event-driven) ─ */
    "mpris": {
        "format": "{player_icon}  {dynamic}",
        "format-paused": "{status_icon} <i>{dynamic}</i>",
        "player-icons": {
            "default": "󰎆",
            "brave": "󰊯",
            "chromium": "󰊯",
            "chrome": "󰊯",
            "firefox": "󰈹",
            "zen": "󰈹",
            "spotify": "󰓇",
            "strawberry": "󰎆",
            "mpv": "󰎆",
            "vlc": "󰕼"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " · ",
        "dynamic-len": 28,
        "max-length": 32,
        "tooltip-format": "{player} ({status}): {title} - {artist}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "smooth-scrolling-threshold": 1
    },

    /* ── Centro de Control (Drawer Plegable para Luz Nocturna y Cafeína) */
    "group/quicksettings": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "quicksettings-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/quicksettings",
            "custom/gammastep",
            "custom/caffeine"
        ]
    },

    "custom/quicksettings": {
        "format": "󰒓",
        "tooltip-format": "Centro de Control\nClick para expandir / ocultar Luz Nocturna y Modo Cafeína",
        "tooltip": true
    },

    "custom/gammastep": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰌵",
            "inactive": "󰌶"
        },
        "return-type": "json",
        "exec": "if pgrep -x gammastep >/dev/null; then echo '{\"alt\": \"active\", \"tooltip\": \"Luz Nocturna: Activada\\nClic para desactivar\", \"class\": \"active\"}'; else echo '{\"alt\": \"inactive\", \"tooltip\": \"Luz Nocturna: Desactivada\\nClic para activar\", \"class\": \"inactive\"}'; fi",
        "interval": 10,
        "on-click": "~/.local/bin/gammastep-toggle.sh; pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": true
    },

    "custom/caffeine": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰅶",
            "inactive": "󰾪"
        },
        "return-type": "json",
        "exec": "if [ -f \"$HOME/.config/caffeine_active\" ] || [ -f \"${XDG_RUNTIME_DIR:-/tmp}/caffeine_active\" ]; then echo '{\"alt\": \"active\", \"tooltip\": \"Modo Cafeína: Activado\\nClic para desactivar\", \"class\": \"active\"}'; else echo '{\"alt\": \"inactive\", \"tooltip\": \"Modo Cafeína: Desactivado\\nClic para activar\", \"class\": \"inactive\"}'; fi",
        "interval": 10,
        "on-click": "~/.local/bin/caffeine-toggle.sh; pkill -RTMIN+9 waybar",
        "signal": 9,
        "tooltip": true
    },

    /* ── Grupo Unificado de Controles de Hardware (Red, Audio, Batería) ─── */
    "group/controls": {
        "orientation": "horizontal",
        "spacing": 0,
        "modules": [
            "group/network",
            "group/audio",
            "group/battery"
        ]
    },

    /* ── Batería Drawer (Solo Laptops) ───────────────────────────── */
    "group/battery": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "battery#icon",
            "battery#text"
        ]
    },
    "battery#icon": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-full": "󰁹",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Batería: {capacity}%\n{timeTo} — {power:.1f}W",
        "interval": 10
    },
    "battery#text": {
        "format": "{capacity}%",
        "tooltip-format": "{timeTo}\n{power:.1f}W",
        "interval": 10
    },

    /* ── Audio Drawer ────────────────────────────────────────────── */
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "pulseaudio#icon",
            "pulseaudio#text"
        ]
    },
    "pulseaudio#icon": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "format-bluetooth-muted": "󰂲",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Audio: {volume}%\n{desc}"
    },
    "pulseaudio#text": {
        "format": "{volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    /* ── Red Drawer ──────────────────────────────────────────────── */
    "group/network": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "network#icon",
            "network#text"
        ]
    },
    "network#icon": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor",
        "interval": 5
    },
    "network#text": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "LAN",
        "format-linked": "Sin IP",
        "format-disconnected": "OFF",
        "tooltip-format-wifi": "{essid}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "on-click": "nm-connection-editor",
        "interval": 5
    },

    /* ── Monitor de Sistema / Hardware Unificado (Click-to-Reveal) ── */
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "hardware-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/hardware-toggle",
            "group/cpu",
            "group/memory",
            "group/disk",
            "temperature"
        ]
    },

    "custom/hardware-toggle": {
        "format": "󰅁",
        "tooltip-format": "Estadísticas de Hardware (CPU, RAM, Disco, Temperatura)\nClick para expandir / ocultar",
        "tooltip": true
    },

    /* ── CPU ─────────────────────────────────────────────────────── */
    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu#icon",
            "cpu#text"
        ]
    },
    "cpu#icon": {
        "format": "󰻠",
        "interval": 3,
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "on-click": "foot -e btop"
    },
    "cpu#text": {
        "format": "{usage}%",
        "interval": 3,
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "on-click": "foot -e btop"
    },

    /* ── Memoria RAM ─────────────────────────────────────────────── */
    "group/memory": {
        "orientation": "horizontal",
        "modules": [
            "memory#icon",
            "memory#text"
        ]
    },
    "memory#icon": {
        "format": "󰍛",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "on-click": "foot -e btop"
    },
    "memory#text": {
        "format": "{percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "on-click": "foot -e btop"
    },

    /* ── Disco ───────────────────────────────────────────────────── */
    "group/disk": {
        "orientation": "horizontal",
        "modules": [
            "disk#icon",
            "disk#text"
        ]
    },
    "disk#icon": {
        "format": "󰋊",
        "interval": 30,
        "path": "/",
        "tooltip-format": "Disco: {used} de {total} ({percentage_used}% usado)\nLibre: {free}",
        "on-click": "foot -e btop"
    },
    "disk#text": {
        "format": "{percentage_used}%",
        "interval": 30,
        "path": "/",
        "tooltip-format": "Disco: {used} de {total} ({percentage_used}% usado)\nLibre: {free}",
        "on-click": "foot -e btop"
    },

    /* ── Temperatura en Drawer Hardware (CPU k10temp) ────────────── */
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "warning-threshold": 65,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "󰔏 {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "interval": 3,
        "tooltip-format": "Temperatura CPU: {temperatureC}°C\nClic para abrir btop",
        "on-click": "foot -e btop"
    },

    /* ── Bandeja del Sistema ─────────────────────────────────────── */
    "tray": {
        "icon-size": 12,
        "spacing": 5
    },

    /* ── Menú de Apagado / Sesión ────────────────────────────────── */
    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Menú de Apagado y Sesión",
        "on-click": "~/.local/bin/power-menu.sh",
        "tooltip": true
    }
}
