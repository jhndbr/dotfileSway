{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/menu",
        "sway/workspaces",
        "sway/mode",
        "sway/scratchpad",
        "sway/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/media",
        "tray",
        "custom/quicksettings",
        "group/controls",
        "group/hardware",
        "custom/power"
    ],

    /* ── Menú de Inicio Minimalista (Estilo Apple / Linux) ───────── */
    "custom/menu": {
        "format": "󰣇",
        "tooltip-format": "Lanzador de Aplicaciones (Wofi)",
        "on-click": "wofi --show drun",
        "tooltip": true
    },

    /* ── Espacios de Trabajo Estilo Cápsula macOS ────────────────── */
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },

    "sway/mode": {
        "format": "󰩨 {}",
        "max-length": 50
    },

    "sway/scratchpad": {
        "format": "󰖯 {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "sway/window": {
        "format": "{}",
        "max-length": 40,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*) - foot": "󰞷  $1",
            "(.*) — yazi": "󰝰  $1",
            "yazi": "󰝰  Yazi",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*) - Code": "󰨞  $1",
            "(.*) - Zed": "󰅩  $1",
            "(.*) — Spotify": "󰓇  $1",
            "Volume Control": "󰕾  Pavucontrol",
            "Bluetooth Devices": "󰂯  Blueman"
        },
        "tooltip": false
    },

    /* ── Reloj y Fecha (Estilo Barra de Menú macOS) ──────────────── */
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A %d de %B, %Y  ·  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "locale": "es_AR.UTF-8",
        "interval": 1
    },

    /* ── Mini Reproductor Multimedia Flotante ────────────────────── */
    "custom/media": {
        "format": "󰝚 {text}",
        "return-type": "json",
        "max-length": 32,
        "format-icons": {
            "spotify": "󰓇",
            "default": "󰝚"
        },
        "escape": true,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}} : {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F 2>/dev/null",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-"
    },

    /* ── Centro de Control (QuickSettings Wofi) ──────────────────── */
    "custom/quicksettings": {
        "format": "󰒓",
        "tooltip-format": "Centro de Control &amp; Herramientas\n(Pantallas, Luz Cálida, Notificaciones, etc.)",
        "on-click": "~/.local/bin/quicksettings-menu.sh",
        "tooltip": true
    },

    /* ── Grupo Unificado de Controles de Hardware ────────────────── */
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "group/network",
            "group/backlight",
            "group/audio",
            "group/battery"
        ]
    },

    /* ── Audio Drawer ────────────────────────────────────────────── */
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "pulseaudio#icon",
            "pulseaudio#text"
        ]
    },
    "pulseaudio#icon": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "format-bluetooth-muted": "󰂲",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Audio: {volume}%\n{desc}"
    },
    "pulseaudio#text": {
        "format": "{volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    /* ── Brillo Drawer ───────────────────────────────────────────── */
    "group/backlight": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "backlight#icon",
            "backlight#text"
        ]
    },
    "backlight#icon": {
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "tooltip-format": "Brillo: {percent}%"
    },
    "backlight#text": {
        "format": "{percent}%",
        "scroll-step": 5,
        "tooltip-format": "Brillo: {percent}%"
    },

    /* ── Red Drawer ──────────────────────────────────────────────── */
    "group/network": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "network#icon",
            "network#text"
        ]
    },
    "network#icon": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor",
        "interval": 5
    },
    "network#text": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "LAN",
        "format-linked": "Sin IP",
        "format-disconnected": "OFF",
        "tooltip-format-wifi": "{essid}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "on-click": "nm-connection-editor",
        "interval": 5
    },

    /* ── Batería Drawer ──────────────────────────────────────────── */
    "group/battery": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "battery#icon",
            "battery#text"
        ]
    },
    "battery#icon": {
        "states": {
            "good": 80,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "format-charging": "󰂄",
        "format-plugged": "󰚥",
        "format-full": "󰁹",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Batería: {capacity}%\n{timeTo} — {power:.1f}W",
        "interval": 10
    },
    "battery#text": {
        "format": "{capacity}%",
        "tooltip-format": "{timeTo}\n{power:.1f}W",
        "interval": 10
    },

    /* ── Monitor de Sistema / Hardware Drawer ────────────────────── */
    "group/hardware": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 350,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/system-icon",
            "cpu",
            "memory",
            "temperature"
        ]
    },
    "custom/system-icon": {
        "format": "󰍛",
        "tooltip-format": "Monitor de Rendimiento\n(Hover para ver CPU, RAM y Temp)",
        "on-click": "foot -e btop"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 3,
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "on-click": "foot -e btop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "on-click": "foot -e btop"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°",
        "format-critical": "󰔏 {temperatureC}°",
        "tooltip-format": "Temperatura: {temperatureC}°C"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 6
    },

    /* ── Menú de Apagado / Sesión ────────────────────────────────── */
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Menú de Apagado y Sesión",
        "on-click": "~/.local/bin/power-menu.sh",
        "tooltip": true
    }
}
