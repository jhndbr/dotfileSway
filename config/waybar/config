{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/menu",
        "sway/workspaces",
        "sway/window"
    ],

    "modules-center": [
        "group/weather",
        "clock"
    ],

    "modules-right": [
        "custom/media",
        "custom/cava",
        "tray",
        "group/quicksettings",
        "group/controls",
        "group/hardware",
        "custom/power"
    ],

    /* ── Menú de Inicio Minimalista ──────────────────────────────── */
    "custom/menu": {
        "format": "󰣇",
        "tooltip-format": "Lanzador de Aplicaciones (Wofi)",
        "on-click": "wofi --show drun",
        "tooltip": true
    },

    /* ── Espacios de Trabajo Estilo Cápsula Compacta ─────────────── */
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": {
            "*": 5
        }
    },

    /* ── Nombre de Aplicación e Icono Representativo ─────────────── */
    "sway/window": {
        "format": "{app_id}",
        "max-length": 28,
        "icon": false,
        "rewrite": {
            "": "󰖯  Escritorio",
            "^$": "󰖯  Escritorio",
            "firefox": "󰈹  Firefox",
            "zen-alpha": "󰈹  Zen Browser",
            "zen": "󰈹  Zen Browser",
            "google-chrome": "󰊯  Chrome",
            "chromium": "󰊯  Chromium",
            "Brave-browser": "󰊯  Brave",
            "foot": "󰞷  Terminal",
            "kitty": "󰄛  Kitty",
            "alacritty": "󰞷  Alacritty",
            "code-oss": "󰨞  VS Code",
            "code": "󰨞  VS Code",
            "Code": "󰨞  VS Code",
            "vscodium": "󰨞  VSCodium",
            "dev.zed.Zed": "󰅩  Zed Editor",
            "zed": "󰅩  Zed Editor",
            "antigravity": "󰧑  Antigravity",
            "org.gnome.Nautilus": "󰝰  Archivos",
            "nautilus": "󰝰  Archivos",
            "thunar": "󰝰  Thunar",
            "Thunar": "󰝰  Thunar",
            "Spotify": "󰓇  Spotify",
            "spotify": "󰓇  Spotify",
            "discord": "󰙯  Discord",
            "vesktop": "󰙯  Vesktop",
            "org.telegram.desktop": "󰒓  Telegram",
            "telegram-desktop": "󰒓  Telegram",
            "pavucontrol": "󰕾  Pavucontrol",
            "blueman-manager": "󰂯  Blueman",
            "mpv": "󰎆  MPV",
            "vlc": "󰕼  VLC",
            "Gimp": "󰽉  GIMP",
            "inkscape": "󰽉  Inkscape",
            "obsidian": "󱓧  Obsidian",
            "btop": "󰻠  btop",
            "org.gnome.Calculator": "󰃬  Calculadora",
            "org.gnome.Evince": "󰈙  Documentos",
            "imv": "󰋩  Visor",
            "swayimg": "󰋩  Visor",
            "wofi": "󰣇  Lanzador"
        },
        "tooltip": true,
        "tooltip-format": "{title}"
    },

    /* ── Clima Drawer en el Centro (Muestra Temperatura en Hover) ── */
    "group/weather": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "custom/weather-icon",
            "custom/weather-text"
        ]
    },

    "custom/weather-icon": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-weather.sh icon",
        "interval": 300,
        "tooltip": true,
        "on-click": "xdg-open 'https://wttr.in' 2>/dev/null || true"
    },

    "custom/weather-text": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-weather.sh text",
        "interval": 300,
        "tooltip": true,
        "on-click": "xdg-open 'https://wttr.in' 2>/dev/null || true"
    },

    /* ── Reloj y Fecha (Centro) ──────────────────────────────────── */
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "format-alt": "{:%A %d de %B, %Y  ·  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "locale": "es_AR.UTF-8",
        "interval": 1
    },

    /* ── Mini Reproductor Multimedia ─────────────────────────────── */
    "custom/media": {
        "format": "{}",
        "return-type": "json",
        "max-length": 30,
        "exec": "~/.local/bin/waybar-media.py",
        "interval": 2,
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl volume 0.05+",
        "on-scroll-down": "playerctl volume 0.05-",
        "smooth-scrolling-threshold": 1
    },

    /* ── Visualizador de Audio CAVA ──────────────────────────────── */
    "custom/cava": {
        "format": "{}",
        "return-type": "json",
        "exec": "~/.local/bin/waybar-cava.py",
        "tooltip": true
    },

    /* ── Centro de Control (Drawer Plegable para Luz Nocturna y Cafeína) */
    "group/quicksettings": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "quicksettings-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/quicksettings",
            "custom/gammastep",
            "custom/caffeine"
        ]
    },

    "custom/quicksettings": {
        "format": "󰒓",
        "tooltip-format": "Centro de Control\nClick para expandir / ocultar Luz Nocturna y Modo Cafeína",
        "tooltip": true
    },

    "custom/gammastep": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰌵",
            "inactive": "󰌶"
        },
        "return-type": "json",
        "exec": "if pgrep -x gammastep >/dev/null; then echo '{\"alt\": \"active\", \"tooltip\": \"Luz Nocturna: Activada\\nClic para desactivar\", \"class\": \"active\"}'; else echo '{\"alt\": \"inactive\", \"tooltip\": \"Luz Nocturna: Desactivada\\nClic para activar\", \"class\": \"inactive\"}'; fi",
        "interval": 2,
        "on-click": "~/.local/bin/gammastep-toggle.sh; pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": true
    },

    "custom/caffeine": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰅶",
            "inactive": "󰾪"
        },
        "return-type": "json",
        "exec": "if [ -f \"$HOME/.config/caffeine_active\" ] || [ -f \"${XDG_RUNTIME_DIR:-/tmp}/caffeine_active\" ]; then echo '{\"alt\": \"active\", \"tooltip\": \"Modo Cafeína: Activado\\nClic para desactivar\", \"class\": \"active\"}'; else echo '{\"alt\": \"inactive\", \"tooltip\": \"Modo Cafeína: Desactivado\\nClic para activar\", \"class\": \"inactive\"}'; fi",
        "interval": 2,
        "on-click": "~/.local/bin/caffeine-toggle.sh; pkill -RTMIN+9 waybar",
        "signal": 9,
        "tooltip": true
    },

    /* ── Grupo Unificado de Controles de Hardware (Audio & Red) ─── */
    "group/controls": {
        "orientation": "horizontal",
        "spacing": 0,
        "modules": [
            "group/network",
            "group/audio"
        ]
    },

    /* ── Audio Drawer ────────────────────────────────────────────── */
    "group/audio": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "pulseaudio#icon",
            "pulseaudio#text"
        ]
    },
    "pulseaudio#icon": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "format-bluetooth-muted": "󰂲",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "Audio: {volume}%\n{desc}"
    },
    "pulseaudio#text": {
        "format": "{volume}%",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "scroll-step": 5,
        "tooltip-format": "{desc}"
    },

    /* ── Red Drawer ──────────────────────────────────────────────── */
    "group/network": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": true
        },
        "modules": [
            "network#icon",
            "network#text"
        ]
    },
    "network#icon": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Desconectado",
        "on-click": "nm-connection-editor",
        "interval": 5
    },
    "network#text": {
        "format-wifi": "{signalStrength}%",
        "format-ethernet": "LAN",
        "format-linked": "Sin IP",
        "format-disconnected": "OFF",
        "tooltip-format-wifi": "{essid}\n↑ {bandwidthUpBits}  ↓ {bandwidthDownBits}",
        "on-click": "nm-connection-editor",
        "interval": 5
    },

    /* ── Monitor de Sistema / Hardware Unificado (Click-to-Reveal) ── */
    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "hardware-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": true
        },
        "modules": [
            "custom/hardware-toggle",
            "group/cpu",
            "group/memory",
            "group/disk",
            "temperature"
        ]
    },

    "custom/hardware-toggle": {
        "format": "",
        "tooltip-format": "Estadísticas de Hardware (CPU, RAM, Disco, Temperatura)\nClick para expandir / ocultar",
        "tooltip": true
    },

    /* ── CPU ─────────────────────────────────────────────────────── */
    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu#icon",
            "cpu#text"
        ]
    },
    "cpu#icon": {
        "format": "󰻠",
        "interval": 3,
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "on-click": "foot -e btop"
    },
    "cpu#text": {
        "format": "{usage}%",
        "interval": 3,
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz",
        "on-click": "foot -e btop"
    },

    /* ── Memoria RAM ─────────────────────────────────────────────── */
    "group/memory": {
        "orientation": "horizontal",
        "modules": [
            "memory#icon",
            "memory#text"
        ]
    },
    "memory#icon": {
        "format": "󰍛",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "on-click": "foot -e btop"
    },
    "memory#text": {
        "format": "{percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} GiB / {total:0.1f} GiB ({percentage}%)\nSwap: {swapUsed:0.1f} GiB / {swapTotal:0.1f} GiB",
        "on-click": "foot -e btop"
    },

    /* ── Disco ───────────────────────────────────────────────────── */
    "group/disk": {
        "orientation": "horizontal",
        "modules": [
            "disk#icon",
            "disk#text"
        ]
    },
    "disk#icon": {
        "format": "󰋊",
        "interval": 30,
        "path": "/",
        "tooltip-format": "Disco: {used} de {total} ({percentage_used}% usado)\nLibre: {free}",
        "on-click": "foot -e btop"
    },
    "disk#text": {
        "format": "{percentage_used}%",
        "interval": 30,
        "path": "/",
        "tooltip-format": "Disco: {used} de {total} ({percentage_used}% usado)\nLibre: {free}",
        "on-click": "foot -e btop"
    },

    /* ── Temperatura en Drawer Hardware (CPU k10temp) ────────────── */
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "warning-threshold": 65,
        "format": "{icon} {temperatureC}°C",
        "format-critical": "󰔏 {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "interval": 3,
        "tooltip-format": "Temperatura CPU: {temperatureC}°C\nClic para abrir btop",
        "on-click": "foot -e btop"
    },

    /* ── Bandeja del Sistema ─────────────────────────────────────── */
    "tray": {
        "icon-size": 12,
        "spacing": 5
    },

    /* ── Menú de Apagado / Sesión ────────────────────────────────── */
    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Menú de Apagado y Sesión",
        "on-click": "~/.local/bin/power-menu.sh",
        "tooltip": true
    }
}
