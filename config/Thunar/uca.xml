<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Abrir terminal aquí</name>
	<submenu></submenu>
	<unique-id>1787974507441071-1</unique-id>
	<command>sh -c 'if [ -d "$1" ]; then exec foot -D "$1"; else exec foot -D "$(dirname "$1")"; fi' _ %f</command>
	<description>Abrir terminal Foot en la carpeta seleccionada o actual</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
	<other-files/>
	<text-files/>
	<image-files/>
	<audio-files/>
	<video-files/>
</action>
<action>
	<icon>preferences-desktop-wallpaper</icon>
	<name>Establecer como fondo de pantalla</name>
	<submenu></submenu>
	<unique-id>set-wallpaper-action</unique-id>
	<command>sh -c 'PATH="$HOME/.local/bin:$PATH" exec set-wallpaper.sh "$1"' _ %f</command>
	<description>Establecer como fondo de pantalla y generar paleta dinámica Matugen</description>
	<range></range>
	<patterns>*.png;*.jpg;*.jpeg;*.webp;*.bmp;*.gif;*.PNG;*.JPG;*.JPEG;*.WEBP;*.BMP;*.GIF;*.avif;*.AVIF</patterns>
	<image-files/>
</action>
<action>
	<icon>package-x-generic</icon>
	<name>Extraer aquí</name>
	<submenu></submenu>
	<unique-id>ouch-extract-here</unique-id>
	<command>sh -c 'PATH="$HOME/.local/bin:$PATH" exec thunar-ouch.sh extract-here "$@"' _ %F</command>
	<description>Extraer inmediatamente en este directorio usando ouch</description>
	<range></range>
	<patterns>*.tar;*.tar.gz;*.tgz;*.tar.bz2;*.tbz2;*.tar.xz;*.txz;*.tar.zst;*.tzst;*.zip;*.rar;*.7z;*.gz;*.bz2;*.xz;*.zst;*.lz4;*.br;*.sz;*.z;*.TAR;*.TAR.GZ;*.TGZ;*.TAR.BZ2;*.TBZ2;*.TAR.XZ;*.TXZ;*.TAR.ZST;*.TZST;*.ZIP;*.RAR;*.7Z;*.GZ;*.BZ2;*.XZ;*.ZST;*.Z</patterns>
	<other-files/>
</action>
